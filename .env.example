# Скопируйте в .env и заполните. Файл .env в git не попадает.

NODE_ENV=development
PORT=3001

MONGO_URI=mongodb://localhost:27017/byte

# Длинная случайная строка. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Через запятую, если адресов несколько
CORS_ORIGIN=http://localhost:3000

# SMTP для писем с кодом подтверждения. Для Gmail нужен app password.
# Если не заполнено, код подтверждения пишется в консоль сервера.
SMTP_SERVICE=gmail
SMTP_USER=
SMTP_PASS=
